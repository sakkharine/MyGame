--- !u!114 &2077353459
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2077353457}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 02a24132134467644a0bc8a6e20623bc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  sceneName: Empty
  delayBeforeLoad: 0.1
  triggeringTag: Player
  ignoreKarma: 1
  isAltWorld: 0
  isSceneDependsOnKarma: 1
  goodKarmaScene: GoodEnding
  badKarmaScene: BadEnding
  goodEndingVoice:
    Guid:
      Data1: 420511992
      Data2: 1221978783
      Data3: -2091924043
      Data4: -2118384517
    Path: event:/Voiceover/kanec_dobry
  badEndingVoice:
    Guid:
      Data1: 1666333430
      Data2: 1100745739
      Data3: 926472338
      Data4: 676806327
    Path: event:/Voiceover/kanecalt
  goodEndingSubtitles:
  - time: 0
    text: "\u0417 \u0446\u0435\u043C\u0440\u044B \u0437\u2019\u044F\u0432\u0456\u043B\u0430\u0441\u044F
      \u041C\u0430\u0440\u0430."
  - time: 3
    text: "\u0411\u0430\u0433\u0456\u043D\u044F \u043F\u0440\u0430\u043C\u043E\u0432\u0456\u043B\u0430,
      \u0448\u0442\u043E \u045E\u0432\u0435\u0441\u044C \u0447\u0430\u0441 \u043D\u0430\u0437\u0456\u0440\u0430\u043B\u0430
      \u0437\u0430 \u0434\u0437\u044F\u045E\u0447\u044B\u043D\u0430\u0439."
  - time: 9
    text: "\u042F\u043D\u0430 \u0430\u0446\u0430\u043D\u0456\u043B\u0430 \u0441\u0442\u0430\u0440\u0430\u043D\u043D\u0430\u0441\u0446\u044C
      \u0434\u0437\u044F\u045E\u0447\u044B\u043D\u044B \u0456 \u044F\u0435 \u0430\u0441\u0446\u044F\u0440\u043E\u0436\u043D\u0430\u0441\u0446\u044C
      \u0437 \u043C\u0430\u0433\u0456\u044F\u0439 \u041D\u0430\u0432\u0456."
  - time: 13
    text: "\u042F\u043D\u0430 \u0430\u0446\u0430\u043D\u0456\u043B\u0430 \u0441\u0442\u0430\u0440\u0430\u043D\u043D\u0430\u0441\u0446\u044C
      \u0434\u0437\u044F\u045E\u0447\u044B\u043D\u044B \u0456 \u044F\u0435 \u0430\u0441\u0446\u044F\u0440\u043E\u0436\u043D\u0430\u0441\u0446\u044C
      \u0437 \u043C\u0430\u0433\u0456\u044F\u0439 \u041D\u0430\u0432\u0456."
  badEndingSubtitles:
  - time: 0
    text: "\u0417 \u0446\u0435\u043C\u0440\u044B \u0437\u2019\u044F\u0432\u0456\u043B\u0430\u0441\u044F
      \u041C\u0430\u0440\u0430."
  - time: 5
    text: "\u041B\u0435\u0434\u0437\u044F\u043D\u044B \u043F\u043E\u0437\u0456\u0440\u043A
      \u041C\u0430\u0440\u044B \u043F\u0440\u0430\u0446\u044F\u045E \u0434\u0437\u044F\u045E\u0447\u044B\u043D\u0443
      \u043D\u0430\u0432\u044B\u043B\u0451\u0442."
  - time: 8
    text: "\u0411\u0430\u0433\u0456\u043D\u044F \u043D\u0430\u0437\u0456\u0440\u0430\u043B\u0430
      \u0437\u0430 \u043A\u043E\u0436\u043D\u044B\u043C \u043A\u0440\u043E\u043A\u0430\u043C
      \u0456 \u045E\u0431\u0430\u0447\u044B\u043B\u0430 \u043F\u0435\u0440\u0430\u0434
      \u0441\u0430\u0431\u043E\u0439 \u0437\u043D\u0430\u0445\u043E\u0434\u043B\u0456\u0432\u0443\u044E, "
  - time: 13
    text: "\u0441\u043F\u0440\u044B\u0442\u043D\u0443\u044E \u0456 \u0445\u0456\u0442\u0440\u0443\u044E
      \u0456\u0441\u0442\u043E\u0442\u0443, \u0448\u0442\u043E \u0442\u0430\u043A
      \u043B\u0451\u0433\u043A\u0430 \u0430\u0441\u0432\u043E\u0456\u043B\u0430\u0441\u044F
      \u045E \u043B\u0435\u0441\u0435. "
  - time: 17
    text: " \u041C\u0430\u0440\u0430 \u0432\u044B\u0440\u0430\u0448\u044B\u043B\u0430:
      \u0434\u0437\u044F\u045E\u0447\u044B\u043D\u0430 \u0441\u0442\u0430\u043D\u0435
      \u044F\u0435 \u0433\u043E\u0434\u043D\u0430\u0439 \u043F\u0435\u0440\u0430\u0435\u043C\u043D\u0456\u0446\u0430\u0439. "
  - time: 21
    text: "\u0426\u044F\u043F\u0435\u0440 \u044F\u043D\u0430 \u2014 \u0432\u0443\u0447\u0430\u043D\u0456\u0446\u0430
      \u0431\u0430\u0433\u0456\u043D\u0456, \u043D\u043E\u0432\u0430\u044F \u043B\u044F\u0441\u043D\u0430\u044F
      \u0432\u0435\u0434\u0437\u044C\u043C\u0430."
  - time: 24
    text: "\u0426\u044F\u043F\u0435\u0440 \u044F\u043D\u0430 \u2014 \u0432\u0443\u0447\u0430\u043D\u0456\u0446\u0430
      \u0431\u0430\u0433\u0456\u043D\u0456, \u043D\u043E\u0432\u0430\u044F \u043B\u044F\u0441\u043D\u0430\u044F
      \u0432\u0435\u0434\u0437\u044C\u043C\u0430."
  verbose: 1
